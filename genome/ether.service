[Unit]
Description=ETHER - membre vivant ALPHATECH (genome immuable)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/alphatech-omniscience/genome
EnvironmentFile=/root/alphatech-omniscience/genome/.env
ExecStart=/usr/bin/node /root/alphatech-omniscience/genome/agent.mjs
Restart=always
RestartSec=10
StandardOutput=append:/root/alphatech-omniscience/genome/run.log
StandardError=append:/root/alphatech-omniscience/genome/run.log

[Install]
WantedBy=multi-user.target
